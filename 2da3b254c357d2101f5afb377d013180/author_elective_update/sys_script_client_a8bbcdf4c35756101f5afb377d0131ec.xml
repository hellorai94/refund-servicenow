        <name>Past Date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
 
   var today = new Date();
   var startDate = new Date(g_form.getValue("refund_date"));
 
   if (startDate.valueOf() > today.valueOf()) {
       g_form.addErrorMessage("Select only past dates.");
       g_form.clearValue("refund_date");
       return false;
   }
}]]></script>
